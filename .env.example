# Generated locally by `uv run invoke init-secrets`.
# Keep credential values empty. Never commit the generated .env file.
INFRAHUB_INITIAL_ADMIN_PASSWORD=
INFRAHUB_API_TOKEN=
INFRAHUB_SECURITY_SECRET_KEY=
SEMAPHORE_ADMIN_PASSWORD=

# Optional ANTA execution. This password must match the target EOS devices.
ANTA_PASSWORD=

# Optional CloudVision integration. Generate a service-account token in CloudVision.
CLOUDVISION_SERVERS=www.cv-prod-euwest-2.arista.io
CLOUDVISION_TOKEN=
CLOUDVISION_VERIFY_CERTS=true
