# Generated locally by `uv run invoke init-secrets`.
# Keep credential values empty. Never commit the generated .env file.
INFRAHUB_INITIAL_ADMIN_PASSWORD=
INFRAHUB_API_TOKEN=
INFRAHUB_SECURITY_SECRET_KEY=
SEMAPHORE_ADMIN_PASSWORD=

# Seed fabric directories: all (default), none (Common only), or a comma-separated list.
# Example: l3ls-multi-domain,l2ls
INFRAHUB_SEED_FABRICS=all

# Optional overrides for the Semaphore container. Invoke commands default to
# the current host user's UID/GID so files in bind mounts remain accessible.
# Set these only when the host bind-mount directories are owned by that UID/GID.
# SEMAPHORE_UID=1000
# SEMAPHORE_GID=1000

# Optional CloudVision integration. Generate a service-account token in CloudVision.
CLOUDVISION_SERVERS=www.cv-prod-euwest-2.arista.io
CLOUDVISION_TOKEN=
CLOUDVISION_VERIFY_CERTS=true
